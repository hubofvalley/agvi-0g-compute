{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "declaration": false,
    "rootDir": "src",
    "outDir": "dist",
    "skipLibCheck": true
  },
  "include": [
    "src/catalog.ts",
    "src/config.ts",
    "src/discovery.ts",
    "src/identifiers.ts",
    "src/index.ts",
    "src/pricing.ts",
    "src/tools/*.ts",
    "src/transport.ts"
  ],
  "exclude": [
    "src/**/*.test.ts"
  ]
}
